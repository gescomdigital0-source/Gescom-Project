# ============================================================
# GESCOM PROJECT – Variables d'environnement
# Copiez ce fichier vers « .env » puis adaptez les valeurs.
# Sur Vercel : Project Settings → Environment Variables.
# ============================================================

# ------------------------------------------------------------
# BASE DE DONNÉES (obligatoire)
# ------------------------------------------------------------
# Local / self-hosted (fichier SQLite — mode par défaut) :
DATABASE_URL=file:./db/custom.db

# Production Vercel (base Turso hébergée, gratuite) — remplacez la ligne
# ci-dessus par les deux suivantes, récupérées depuis votre compte Turso :
# DATABASE_URL=libsql://votre-base-votre-org.turso.io
# DATABASE_AUTH_TOKEN=eyJhbGciOi... (jeton d'accès Turso)

# ------------------------------------------------------------
# ENVOI DES E-MAILS (optionnel — recommandé en production)
# ------------------------------------------------------------
# Sans ces variables, la plateforme reste en « mode démonstration » :
# les codes d'activation s'affichent à l'écran au lieu d'être envoyés.
# Il est aussi possible de configurer le SMTP depuis l'interface
# (compte ADMIN → Paramètres → onglet « E-mail ») sans toucher à ce fichier.
#
# Exemple Gmail (mot de passe d'application à 16 caractères) :
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=votre.adresse@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop   ← mot de passe d'application (sans espaces)
# SMTP_FROM=GESCOM PROJECT <votre.adresse@gmail.com>
#
# Exemple Brevo (300 e-mails/jour gratuits) :
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=votre-compte@brevo.com
# SMTP_PASS=votre-clé-smtp-brevo
# SMTP_FROM=GESCOM PROJECT <expediteur-valide@votre-domaine.com>

# ------------------------------------------------------------
# ENVIRONNEMENT
# ------------------------------------------------------------
# NODE_ENV=production
